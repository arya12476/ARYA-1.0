class Shape {
    void getArea() {
        System.out.println("Area of shape");
    }
}

class Rectangle extends Shape {
    int length = 10;
    int width = 5;

    @Override
    void getArea() {
        int area = length * width;
        System.out.println("Area of Rectangle = " + area);
    }
}

public class Main {
    public static void main(String[] args) {
        Rectangle r = new Rectangle();
        r.getArea();
    }
}
