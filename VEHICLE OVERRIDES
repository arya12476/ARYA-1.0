class Animal {

    void makesound() {
        System.out.println("Animal makes a sound");
    }
}


class Cat extends Animal {

    
    @Override
    void makesound() {
        System.out.println("Cat says: Meow");
    }
}


public class Main {
    public static void main(String[] args) {

        Cat c = new Cat();
        c.makesound();
    }
}
